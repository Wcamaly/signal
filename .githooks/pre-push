#!/usr/bin/env bash
# Refuses to push straight to a protected branch. Work happens on a branch and
# lands through a pull request — see CONTRIBUTING.md.
#
# Enabled by `npm install` (the prepare script runs `git config core.hooksPath .githooks`).
# Enable it by hand with:  git config core.hooksPath .githooks
#
# Escape hatch, for the one-off case where you really mean it:
#   SIGNAL_ALLOW_PUSH_MAIN=1 git push origin main

set -euo pipefail

PROTECTED="main master"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  branch="${remote_ref#refs/heads/}"
  for protected in $PROTECTED; do
    if [ "$branch" = "$protected" ]; then
      if [ "${SIGNAL_ALLOW_PUSH_MAIN:-0}" = "1" ]; then
        printf '\033[1;33m▸\033[0m pushing to %s because SIGNAL_ALLOW_PUSH_MAIN=1\n' "$branch" >&2
        continue
      fi
      cat >&2 <<MSG

  ✖ Direct pushes to "$branch" are blocked.

    git switch -c feat/what-you-are-doing
    git push -u origin feat/what-you-are-doing
    gh pr create --fill

  See CONTRIBUTING.md. To override once: SIGNAL_ALLOW_PUSH_MAIN=1 git push …

MSG
      exit 1
    fi
  done
done

exit 0
