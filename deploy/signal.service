[Unit]
Description=Signal — radar de IA y publicaciones
Documentation=file:/opt/signal/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signal
Group=signal
WorkingDirectory=/opt/signal
EnvironmentFile=/etc/signal.env
ExecStart=/opt/signal/node_modules/.bin/next start -H 0.0.0.0 -p ${PORT}
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

# Endurecimiento: la app sólo necesita escribir en su carpeta de datos.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/signal/data /opt/signal/.next
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=signal

[Install]
WantedBy=multi-user.target
