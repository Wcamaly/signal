[Unit]
Description=Signal — fires the pipeline on Monday mornings

[Timer]
# Monday 08:00, local time of the container.
# Change the day/hour here, then:  systemctl daemon-reload && systemctl restart signal-pipeline.timer
OnCalendar=Mon *-*-* 08:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
